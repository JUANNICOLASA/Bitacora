        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml\n\ntitle Diagrama C4 Nivel 1: Contexto del Sistema - TECH CUP FÚTBOL\n\n&#39; Actores (Personas)\nPerson(estudiante, \&quot;Estudiante / Jugador\&quot;, \&quot;Registro, perfil deportivo, búsqueda de equipo, consulta de resultados y estadísticas.\&quot;)\nPerson(capitan, \&quot;Capitán\&quot;, \&quot;Crea y administra el equipo, gestiona inscripción, alineaciones y jugadores.\&quot;)\nPerson(arbitro, \&quot;Árbitro\&quot;, \&quot;Gestiona el partido en vivo: tiempo, goles, tarjetas y sustituciones.\&quot;)\nPerson(organizador, \&quot;Organizador\&quot;, \&quot;Crea torneos, aprueba inscripciones, gestiona árbitros y ve el dashboard.\&quot;)\nPerson(familiar, \&quot;Graduado / Familiar\&quot;, \&quot;Se registra con correo Gmail y puede participar como jugador o capitán.\&quot;)\n\n&#39; Sistema Central\nSystem(techcup, \&quot;TECH CUP FÚTBOL\&quot;, \&quot;Plataforma web centralizada que gestiona el ciclo completo del torneo semestral.\&quot;)\n\n&#39; Sistemas Externos\nSystem_Ext(smtp, \&quot;Servidor de correo (SMTP)\&quot;, \&quot;Envío de códigos OTP para registro, login y acciones sensibles.\&quot;)\nSystem_Ext(mapas, \&quot;Servicio de mapas\&quot;, \&quot;Muestra ubicación de canchas en el campus.\&quot;)\nSystem_Ext(archivos, \&quot;Almacenamiento de archivos\&quot;, \&quot;Guarda fotos de perfil, escudos de equipo y comprobantes de pago.\&quot;)\n\n&#39; Relaciones - Actores hacia el sistema\nRel(estudiante, techcup, \&quot;Interactúa con\&quot;)\nRel(capitan, techcup, \&quot;Gestiona equipos y alineaciones en\&quot;)\nRel(arbitro, techcup, \&quot;Registra eventos en vivo en\&quot;)\nRel(organizador, techcup, \&quot;Administra el torneo en\&quot;)\nRel(familiar, techcup, \&quot;Participa en\&quot;)\n\n&#39; Relaciones - Sistema hacia externos\nRel(techcup, smtp, \&quot;Envía correos mediante\&quot;)\nRel(techcup, mapas, \&quot;Obtiene ubicaciones de\&quot;)\nRel(techcup, archivos, \&quot;Almacena multimedia en\&quot;)\n\nSHOW_LEGEND()\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZhNegsUgQYoRMtf_w5oP-1">
